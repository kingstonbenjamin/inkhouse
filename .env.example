# Copy to .env next to compose.yaml. Never commit .env.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=paste-a-long-lived-token-here
PORT=8190
# 1 = log actions instead of sending them (try this first); 0 = live
DRY_RUN=1
# Optional: require ?k=<key> once on the Kindle (stored as a cookie)
PANEL_KEY=
